#!/usr/bin/env bash
#MISE description="Validate a single plugin manifest. Usage: mise run validate-plugin <PLUGIN_PATH>"
set -euo pipefail

PLUGIN_PATH="${1:?Usage: mise run validate-plugin <PLUGIN_PATH>}"

if command -v claude >/dev/null 2>&1; then
  CLAUDE="claude"
else
  CLAUDE="mise exec npm:@anthropic-ai/claude-code -- claude"
fi

# Capture stdout+stderr together and take the status from the `||` branch.
# `STATUS=$?` on the line after a plain `OUTPUT="$(...)"` never runs under
# `set -e` — the shell aborts on the failing substitution, so the validator's
# diagnostics were discarded and CI only ever showed a bare exit code.
STATUS=0
OUTPUT="$($CLAUDE plugin validate "$PLUGIN_PATH" 2>&1)" || STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  echo "❌ $PLUGIN_PATH (exit $STATUS)"
  echo "$OUTPUT"
  exit 1
else
  echo "✅ $PLUGIN_PATH"
fi
