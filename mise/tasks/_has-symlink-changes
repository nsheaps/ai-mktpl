#!/usr/bin/env bash
#MISE description="Check if a plugin directory has symlink targets that changed vs a base ref. Returns 0 (true) if symlink targets changed, 1 (false) otherwise."
# Usage: mise run _has-symlink-changes <PLUGIN_DIR> <BASE_REF>
#
# Only considers symlink targets INSIDE the plugin directory. Symlinks pointing
# outside (e.g. to shared/) are intentionally shared dependencies and should not
# trigger per-plugin version bumps.

PLUGIN_DIR="${1:?Usage: mise run _has-symlink-changes <PLUGIN_DIR> <BASE_REF>}"
BASE_REF="${2:?Usage: mise run _has-symlink-changes <PLUGIN_DIR> <BASE_REF>}"

# Bail if plugin dir doesn't exist — prevents ABS_PLUGIN_DIR from being empty,
# which would make the guard pattern "/"* match every absolute path.
[ -d "$PLUGIN_DIR" ] || exit 1

# Resolve the plugin directory to an absolute path for comparison
ABS_PLUGIN_DIR=$(cd "$PLUGIN_DIR" && pwd -P)

for symlink in $(find "$PLUGIN_DIR" -type l 2>/dev/null); do
  target=$(readlink -f "$symlink" 2>/dev/null || true)
  if [[ -n "$target" && "$target" == "$PWD/"* ]]; then
    # Skip symlink targets that resolve outside the plugin directory.
    # Shared libraries (e.g. shared/lib/*.sh) are symlinked by many plugins;
    # changes to them should not trigger individual plugin bumps.
    if [[ "$target" != "$ABS_PLUGIN_DIR/"* ]]; then
      continue
    fi
    rel_target="${target#$PWD/}"
    if git diff --name-only "${BASE_REF}..HEAD" -- "$rel_target" 2>/dev/null | grep -q .; then
      exit 0
    fi
  fi
done
exit 1
