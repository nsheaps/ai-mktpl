{
  "description": "Install 1Password CLI/op-exec, inject secrets on session start, and redact secrets from tool outputs",
  "hooks": {
    "Setup": [
      {
        "matcher": "init",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/op-exec-env-setup.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/install-op.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/op-exec-env.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_note": "Documentation only — PostToolUse does NOT fire from plugin hooks.json due to upstream bug https://github.com/anthropics/claude-code/issues/6305. The working registration happens via settings.local.json injection in op-exec-env.sh::_register_posttooluse_hook().",
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_DATA}/redact-secrets.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
