{
  "description": "Detects rest-owl project artifacts and provides context about workflow state",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-rest-owl-project.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
