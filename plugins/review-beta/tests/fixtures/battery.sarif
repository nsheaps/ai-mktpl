{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "informationUri": "https://semgrep.dev",
          "rules": [
            {
              "id": "subprocess-shell-true",
              "shortDescription": { "text": "shell=True with untrusted input" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "subprocess-shell-true",
          "level": "error",
          "message": { "text": "subprocess call with shell=True and untrusted input" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/vuln.py" },
                "region": { "startLine": 5, "startColumn": 5 }
              }
            }
          ]
        }
      ]
    }
  ]
}
