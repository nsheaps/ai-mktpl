{
  "description": "Install dependencies and build the LSP server on session start if needed",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/setup.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
