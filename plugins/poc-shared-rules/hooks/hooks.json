{
  "description": "Fetch and sync rules from git repositories into .claude/rules/ on session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sync-rules.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
