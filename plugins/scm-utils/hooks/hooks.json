{
  "description": "SCM workflow hooks for branch and PR management",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-git-push-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
