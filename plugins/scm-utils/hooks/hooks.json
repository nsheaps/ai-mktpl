{
  "description": "SCM utilities: pre-commit formatting and uncommitted change reminders",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/format-staged-on-commit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": []
  }
}
